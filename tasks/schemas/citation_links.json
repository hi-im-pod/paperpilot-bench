{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "citation_links",
  "task": {
    "type": "object",
    "required": [
      "id",
      "type",
      "input"
    ],
    "properties": {
      "id": {
        "type": "string"
      },
      "type": {
        "const": "citation_links"
      },
      "input": {
        "type": "object",
        "required": [
          "paper_ids"
        ],
        "properties": {
          "paper_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "description": "corpus paper ID (bare arXiv number)"
            }
          }
        }
      }
    }
  },
  "prediction": {
    "type": "object",
    "required": [
      "id",
      "output"
    ],
    "properties": {
      "id": {
        "type": "string"
      },
      "abstain": {
        "type": "boolean",
        "default": false
      },
      "output": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "edges"
            ],
            "properties": {
              "edges": {
                "type": "array",
                "items": {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "string",
                      "description": "corpus paper ID (bare arXiv number)"
                    },
                    {
                      "type": "string",
                      "description": "corpus paper ID (bare arXiv number)"
                    }
                  ],
                  "minItems": 2,
                  "maxItems": 2
                },
                "description": "[citing, cited]"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "reason"
            ],
            "properties": {
              "reason": {
                "type": "string"
              }
            }
          }
        ]
      },
      "trace": {
        "type": "object",
        "description": "optional: steps, input_tokens, output_tokens, cost_usd"
      }
    }
  }
}
