{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "find_papers",
  "task": {
    "type": "object",
    "required": [
      "id",
      "type",
      "input"
    ],
    "properties": {
      "id": {
        "type": "string"
      },
      "type": {
        "const": "find_papers"
      },
      "input": {
        "type": "object",
        "required": [
          "topic"
        ],
        "properties": {
          "topic": {
            "type": "string"
          }
        }
      }
    }
  },
  "prediction": {
    "type": "object",
    "required": [
      "id",
      "output"
    ],
    "properties": {
      "id": {
        "type": "string"
      },
      "abstain": {
        "type": "boolean",
        "default": false
      },
      "output": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "ranked_ids"
            ],
            "properties": {
              "ranked_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "description": "corpus paper ID (bare arXiv number)"
                },
                "description": "best first; only the top 10 are scored"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "reason"
            ],
            "properties": {
              "reason": {
                "type": "string"
              }
            }
          }
        ]
      },
      "trace": {
        "type": "object",
        "description": "optional: steps, input_tokens, output_tokens, cost_usd"
      }
    }
  }
}
