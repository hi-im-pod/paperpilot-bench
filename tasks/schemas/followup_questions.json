{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "followup_questions",
  "task": {
    "type": "object",
    "required": [
      "id",
      "type",
      "input"
    ],
    "properties": {
      "id": {
        "type": "string"
      },
      "type": {
        "const": "followup_questions"
      },
      "input": {
        "type": "object",
        "required": [
          "topic",
          "paper_ids"
        ],
        "properties": {
          "topic": {
            "type": "string"
          },
          "paper_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "description": "corpus paper ID (bare arXiv number)"
            }
          }
        }
      }
    }
  },
  "prediction": {
    "type": "object",
    "required": [
      "id",
      "output"
    ],
    "properties": {
      "id": {
        "type": "string"
      },
      "abstain": {
        "type": "boolean",
        "default": false
      },
      "output": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "questions"
            ],
            "properties": {
              "questions": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "only the first 5 are scored"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "reason"
            ],
            "properties": {
              "reason": {
                "type": "string"
              }
            }
          }
        ]
      },
      "trace": {
        "type": "object",
        "description": "optional: steps, input_tokens, output_tokens, cost_usd"
      }
    }
  }
}
