{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "grounded_claims",
  "task": {
    "type": "object",
    "required": [
      "id",
      "type",
      "input"
    ],
    "properties": {
      "id": {
        "type": "string"
      },
      "type": {
        "const": "grounded_claims"
      },
      "input": {
        "type": "object",
        "required": [
          "question"
        ],
        "properties": {
          "question": {
            "type": "string"
          }
        }
      }
    }
  },
  "prediction": {
    "type": "object",
    "required": [
      "id",
      "output"
    ],
    "properties": {
      "id": {
        "type": "string"
      },
      "abstain": {
        "type": "boolean",
        "default": false
      },
      "output": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "answer",
              "claims"
            ],
            "properties": {
              "answer": {
                "type": "string"
              },
              "claims": {
                "type": "array",
                "description": "only the first 10 are scored",
                "items": {
                  "type": "object",
                  "required": [
                    "text",
                    "paper_id",
                    "quote"
                  ],
                  "properties": {
                    "text": {
                      "type": "string"
                    },
                    "paper_id": {
                      "type": "string",
                      "description": "corpus paper ID (bare arXiv number)"
                    },
                    "quote": {
                      "type": "string",
                      "description": "verbatim from the paper, at least 6 words"
                    }
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "required": [
              "reason"
            ],
            "properties": {
              "reason": {
                "type": "string"
              }
            }
          }
        ]
      },
      "trace": {
        "type": "object",
        "description": "optional: steps, input_tokens, output_tokens, cost_usd"
      }
    }
  }
}
