{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "comparison_table",
  "task": {
    "type": "object",
    "required": [
      "id",
      "type",
      "input"
    ],
    "properties": {
      "id": {
        "type": "string"
      },
      "type": {
        "const": "comparison_table"
      },
      "input": {
        "type": "object",
        "required": [
          "topic",
          "columns"
        ],
        "properties": {
          "topic": {
            "type": "string"
          },
          "paper_ids": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string",
              "description": "corpus paper ID (bare arXiv number)"
            },
            "description": "null means find the papers yourself"
          },
          "columns": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "name",
                "type"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "type": {
                  "enum": [
                    "numeric",
                    "enum",
                    "text"
                  ]
                },
                "unit": {
                  "type": "string"
                },
                "allowed": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "setting": {
                  "type": "string",
                  "description": "exact dataset/model/metric the value must come from"
                }
              }
            }
          }
        }
      }
    }
  },
  "prediction": {
    "type": "object",
    "required": [
      "id",
      "output"
    ],
    "properties": {
      "id": {
        "type": "string"
      },
      "abstain": {
        "type": "boolean",
        "default": false
      },
      "output": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "rows"
            ],
            "properties": {
              "rows": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "paper_id",
                    "cells"
                  ],
                  "properties": {
                    "paper_id": {
                      "type": "string",
                      "description": "corpus paper ID (bare arXiv number)"
                    },
                    "cells": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "string"
                      },
                      "description": "column -> value, or NOT_REPORTED"
                    },
                    "evidence": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "string"
                      },
                      "description": "column -> verbatim quote"
                    }
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "required": [
              "reason"
            ],
            "properties": {
              "reason": {
                "type": "string"
              }
            }
          }
        ]
      },
      "trace": {
        "type": "object",
        "description": "optional: steps, input_tokens, output_tokens, cost_usd"
      }
    }
  }
}
